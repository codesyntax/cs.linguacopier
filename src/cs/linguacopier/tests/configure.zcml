<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <plone:behavior
      name="cs.linguacopier.tests.categorized"
      title="Test categorization"
      description="Test-only behavior with controlled (token) fields."
      factory="cs.linguacopier.tests.behaviors.TestCategorized"
      provides="cs.linguacopier.tests.behaviors.ITestCategorized"
      for="plone.dexterity.interfaces.IDexterityContent"
      />

</configure>
