<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >

  <plone:behavior
      name="cs.linguacopier.tests.categorized"
      title="Test categorization"
      description="Test-only behavior with controlled (token) fields."
      factory="cs.linguacopier.tests.behaviors.TestCategorized"
      provides="cs.linguacopier.tests.behaviors.ITestCategorized"
      for="plone.dexterity.interfaces.IDexterityContent"
      />

  <plone:behavior
      name="cs.linguacopier.tests.datagrid"
      title="Test data grid"
      description="Test-only behavior with a data grid field."
      factory="cs.linguacopier.tests.behaviors.TestDataGrid"
      provides="cs.linguacopier.tests.behaviors.ITestDataGrid"
      for="plone.dexterity.interfaces.IDexterityContent"
      />

  <plone:behavior
      name="cs.linguacopier.tests.related"
      title="Test related"
      description="Test-only behavior with a relation list on a separate adapter."
      factory="cs.linguacopier.tests.behaviors.TestRelated"
      provides="cs.linguacopier.tests.behaviors.ITestRelated"
      for="plone.dexterity.interfaces.IDexterityContent"
      />

  <plone:behavior
      name="cs.linguacopier.tests.customrelated"
      title="Test custom related"
      description="Test-only behavior with project-specific relation list fields."
      factory="cs.linguacopier.tests.behaviors.TestCustomRelated"
      provides="cs.linguacopier.tests.behaviors.ITestCustomRelated"
      for="plone.dexterity.interfaces.IDexterityContent"
      />

</configure>
