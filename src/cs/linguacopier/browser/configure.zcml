<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="cs.linguacopier"
    >

  <browser:page
      name="copy-content-to"
      for="*"
      class=".copier.CopyContentToLanguage"
      permission="cmf.ManagePortal"
      layer="cs.linguacopier.interfaces.ICsLinguacopierLayer"
      zcml:condition="installed plone.app.multilingual"
      />

  <browser:page
      name="linguacopier-settings"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".controlpanel.LinguacopierSettingsView"
      permission="cmf.ManagePortal"
      layer="cs.linguacopier.interfaces.ICsLinguacopierLayer"
      />

  <browser:page
      name="linguacopier-jobs"
      for="plone.base.interfaces.IPloneSiteRoot"
      class=".controlpanel.JobsView"
      permission="cmf.ManagePortal"
      layer="cs.linguacopier.interfaces.ICsLinguacopierLayer"
      />

  <browser:resource
      name="cs.linguacopier.export.js"
      file="resources/export.js"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="cs.linguacopier.AvailableTargetLanguages"
      component=".vocabularies.AvailableTargetLanguagesFactory"
      />

  <utility
      provides="zope.schema.interfaces.IVocabularyFactory"
      name="cs.linguacopier.CopyModes"
      component=".vocabularies.CopyModesFactory"
      />

</configure>
