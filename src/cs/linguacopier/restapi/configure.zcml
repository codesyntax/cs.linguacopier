<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="cs.linguacopier"
    >

  <!-- Make the plone:service directive available regardless of ZCML load order -->
  <include package="plone.restapi" />

  <plone:service
      method="POST"
      factory=".service.CopyContentToLanguage"
      for="*"
      permission="cmf.ManagePortal"
      name="@copy-content-to"
      />

  <plone:service
      method="GET"
      factory=".copyjobs.CopyJobsGet"
      for="*"
      permission="cmf.ManagePortal"
      name="@copy-jobs"
      />

</configure>
